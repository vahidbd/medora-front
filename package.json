{
  "name": "medora-front",
  "version": "0.1.0",
  "private": true,
  "description": "Medora web app: the staff console, and later the patient app",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:preview": "node dev/preview.mjs dev",
    "build:preview": "node dev/preview.mjs build",
    "start:preview": "node dev/preview.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contract": "node scripts/contract-types.mjs",
    "skills:sync": "node scripts/check-skills.mjs --write",
    "check": "node scripts/check-names.mjs && node scripts/check-file-names.mjs && node scripts/check-skills.mjs && node scripts/check-adr-sync.mjs && node scripts/contract-types.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@clerk/nextjs": "7.7.1",
    "@sentry/nextjs": "11.15.0",
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.25.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
