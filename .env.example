# Copy to .env.local. Development only: never put a staging or production key here.

# The Medora API (medora-backend), reached from this app's server only.
BACKEND_URL=http://localhost:4000

# Clerk: a development instance (pk_test_ / sk_test_). Sign-in lives at /sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# The patient app's Clerk: a second development instance, with sign-up by email code (ADR 0100).
PATIENT_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
PATIENT_CLERK_SECRET_KEY=sk_test_replace_me
# Clerk encrypts the patient instance's secret between the proxy and the page with this. At least 32 characters.
CLERK_ENCRYPTION_KEY=replace_me_with_32_or_more_random_characters

# Hosts that get the staff console (ADR 0180). Every other host is a brand's patient app, if the API knows
# the brand: http://<brand>.localhost:3000 for a brand whose patient host is <brand>.localhost.
#CONSOLE_HOSTS=localhost,127.0.0.1

# Shared with the API: this server signs the visitor's address with it (src/lib/server/client-ip.ts).
# At least 32 characters. Unset locally: the API falls back to the connection's address.
#FORWARDED_IP_SECRET=

# Error tracking in Australia (ADR 0026). Unset: off.
#NEXT_PUBLIC_SENTRY_DSN=

# No Clerk keys and no API? `npm run dev:preview` runs every screen against a local mock (dev/README.md).
